# Copie para ".env". O ".env" real nunca é commitado.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3:1.7b
EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
DB_PATH=data/tia.db
CHROMA_DIR=data/chroma_db
MATERIAIS_DIR=conteudo/materiais
EMENTA_PATH=conteudo/ementa/ementa.json
PERFIS_PATH=conteudo/perfis/perfis.json
PLANEJADOR_TIMEOUT_LLM=12
BANCO_ITENS_PATH=conteudo/banco_itens/itens.json
# Tutor (Agente 2). Valores de desenvolvimento (decisão de 10/10: não otimizar
# para os 15 s do R09 aqui; o R09 será medido na VM).
# Tempo máximo (s) de espera pelo LLM no feedback
TUTOR_TIMEOUT_LLM=120
# Limite de tokens gerados no feedback (folga para 3 frases completas)
TUTOR_MAX_TOKENS=200
# Amostragem do LLM só no feedback do Tutor (as outras chamadas usam o padrão do
# Ollama): temperatura baixa e seed fixa deixam o texto estável entre execuções
TUTOR_TEMPERATURA=0.2
TUTOR_TOP_P=0.9
TUTOR_SEED=42
# Modo do feedback: "ancorado" (reformula a explicação verificada do item, sem
# inventar valores) ou "livre" (explica só pelos trechos do RAG; para comparação)
TUTOR_MODO_FEEDBACK=ancorado
# Quantos trechos do material vão no prompt do feedback
TUTOR_NUM_TRECHOS=4
# Distância máxima do RAG para um trecho ser relevante. PROVISÓRIO: calibrado com
# o material provisório; recalibrar quando o material real chegar.
TUTOR_DISTANCIA_MAXIMA=400
# Diálogo do Tutor: fração mínima dos termos da pergunta que precisa aparecer nos
# trechos do material para chamar o LLM (ajustado só no conjunto de ajuste com
# python -m tia.agentes.tutor.avaliar_dialogo)
TUTOR_COBERTURA_MIN=0.42
# Regra extra do portão: o termo mais raro da pergunta precisa estar nos trechos.
# Desligada (0): em 10/10 barrou as 3 perguntas "fora" que passavam, mas também
# 4 cobertas legítimas (cobertas no conjunto v2: 90% -> 70%)
TUTOR_EXIGE_TERMO_RARO=0
# Dias sem interação com o Tutor para o aluno contar como inativo (incentivo)
INATIVIDADE_DIAS=3
# Relatório (Agente 3). LGPD: o relatório da turma não mostra grupos com menos de
# RELATORIO_MIN_GRUPO alunos. O LLM só redige a interpretação dos números.
RELATORIO_MIN_GRUPO=5
RELATORIO_TIMEOUT_LLM=120
RELATORIO_MAX_TOKENS=250
RELATORIO_TEMPERATURA=0.2
RELATORIO_SEED=42
