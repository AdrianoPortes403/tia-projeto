# Copie para ".env". O ".env" real nunca é commitado.
OLLAMA_URL=http://localhost:11434
# Modelos de chat que a VM baixa e mede (deploy/modelos.sh, deploy/verificar.sh --medir-r09);
# qwen3.5:9b: etiqueta a confirmar com "ollama pull". MODELO_PADRAO: o que os agentes usam
# (CHAT_MODEL, o nome antigo, ainda vale se MODELO_PADRAO não estiver definido).
MODELOS_LLM=qwen3:1.7b,qwen3:4b,qwen3:8b,qwen3.5:9b
MODELO_PADRAO=qwen3:1.7b
EMBED_MODEL=nomic-embed-text
# Como desligar o raciocínio por modelo (primeiro padrão que casar): prompt (/nothink),
# api ("think": false), prompt+api ou nada. Blocos <think> no texto são sempre removidos.
RACIOCINIO_POR_MODELO="qwen3:*=prompt+api;qwen3.5:*=api;*=nada"
OLLAMA_KEEP_ALIVE=30m
DB_PATH=data/tia.db
CHROMA_DIR=data/chroma_db
MATERIAIS_DIR=conteudo/materiais
EMENTA_PATH=conteudo/ementa/ementa.json
PERFIS_PATH=conteudo/perfis/perfis.json
PLANEJADOR_TIMEOUT_LLM=120
# Primeiro acesso (onboarding conversacional + diagnóstico). Sem LLM, o onboarding usa regras.
ONBOARDING_USA_LLM=1
ONBOARDING_TIMEOUT_LLM=60
# Máximo de mensagens do aluno por conversa de cadastro e de chamadas ao LLM por aluno no
# cadastro (somando conversas recomeçadas; depois, só regras). PROVISÓRIO
ONBOARDING_MAX_MENSAGENS=12
# Prazo (dias, 0 = sem prazo) e escopo (completa ou piloto) da matrícula. Fora do piloto: 0 e completa.
# Para o piloto, ver o bloco "PERFIL DE PILOTO" mais abaixo.
PILOTO_PRAZO_DIAS=0
PILOTO_ESCOPO=completa
BANCO_ITENS_PATH=conteudo/banco_itens/itens.json
# Tutor (Agente 2). Valores de desenvolvimento (decisão de 10/10: não otimizar
# para os 15 s do R09 aqui; o R09 será medido na VM).
# Tempo máximo (s) de espera pelo LLM no feedback
TUTOR_TIMEOUT_LLM=120
# Limite de tokens gerados no feedback (folga para 3 frases completas)
TUTOR_MAX_TOKENS=200
# Amostragem do LLM só no feedback do Tutor (as outras chamadas usam o padrão do
# Ollama): temperatura baixa e seed fixa deixam o texto estável entre execuções
TUTOR_TEMPERATURA=0.2
TUTOR_TOP_P=0.9
TUTOR_SEED=42
# Modo do feedback: "ancorado" (reformula a explicação verificada do item, sem
# inventar valores) ou "livre" (explica só pelos trechos do RAG; para comparação)
TUTOR_MODO_FEEDBACK=ancorado
# Quantos trechos do material vão no prompt do feedback
TUTOR_NUM_TRECHOS=4
# Distância máxima do RAG para um trecho ser relevante. Calibrado com
# o material validado do piloto; recalibrar se o material ou o modelo de embedding mudar.
TUTOR_DISTANCIA_MAXIMA=400
# Diálogo do Tutor: fração mínima dos termos da pergunta que precisa aparecer nos
# trechos do material para chamar o LLM (ajustado só no conjunto de ajuste com
# python -m tia.agentes.tutor.avaliar_dialogo)
TUTOR_COBERTURA_MIN=0.42
# Regra extra do portão: o termo mais raro da pergunta precisa estar nos trechos.
# Desligada (0): em 10/10 barrou as 3 perguntas "fora" que passavam, mas também
# 4 cobertas legítimas (cobertas no conjunto v2: 90% -> 70%)
TUTOR_EXIGE_TERMO_RARO=0
# Dias sem interação com o Tutor para o aluno contar como inativo (incentivo)
# Avaliação adaptativa (1.2.5): 3 acertos seguidos sobem, 2 erros seguidos descem, 3 acertos no nível 3 concluem
TUTOR_ACERTOS_SUBIR=3
TUTOR_ERROS_DESCER=2
TUTOR_ACERTOS_CONCLUIR=3
INATIVIDADE_DIAS=3
# Relatório (Agente 3). LGPD: o relatório da turma não mostra grupos com menos de
# RELATORIO_MIN_GRUPO alunos. O LLM só redige a interpretação dos números.
RELATORIO_MIN_GRUPO=5
RELATORIO_TIMEOUT_LLM=120
RELATORIO_MAX_TOKENS=250
RELATORIO_TEMPERATURA=0.2
RELATORIO_SEED=42
# Tendência do acerto (relatório e regra de queda do orquestrador).
RELATORIO_TENDENCIA_JANELA=5
RELATORIO_TENDENCIA_MIN_RESPOSTAS=3
RELATORIO_TENDENCIA_LIMIAR=0.15
# Orquestração: regras de replanejamento (ver docs/arquitetura/arquitetura.md)
ORQ_QUEDA_RESPOSTAS_ENTRE_REPLANOS=5
# Inatividade: a partir de INATIVIDADE_DIAS só incentivo; a trilha só é refeita a
# partir deste número de dias sem atividade
ORQ_INATIVIDADE_REFAZER_DIAS=7
# Conclusão sem domínio: os itens de uma competência acabaram antes de TUTOR_ACERTOS_CONCLUIR
# acertos seguidos no nível 3 ("concluída com ressalvas"). A R1 só avança com acerto da sessão
# >= este valor; abaixo, reforço do pré-requisito ou material-base.
ORQ_ACERTO_MIN_AVANCO=0.6
# ----------------------------------------------------------------------------------------
# PERFIL DE PILOTO (1.5.1, 27/10 a 04/11/2026). Para o piloto, TROQUE os valores das chaves
# acima pelos abaixo (não duplique as chaves). Cópia comentada em deploy/perfil_piloto.env.
#   PILOTO_PRAZO_DIAS=8               prazo de 8 dias a partir da matrícula
#   PILOTO_ESCOPO=piloto              só os tópicos marcados no_piloto na ementa
#   INATIVIDADE_DIAS=2                incentivo a partir de 2 dias sem atividade
#   ORQ_INATIVIDADE_REFAZER_DIAS=4    trilha refeita a partir de 4 dias sem atividade
# ATENÇÃO: INATIVIDADE_DIAS também é o limiar do alerta "inatividade" do painel do docente,
# do engajamento do Relatório (aluno e turma) e do texto da narrativa: com 2, todos passam
# a considerar inativo quem está há 2 dias sem atividade.
# ----------------------------------------------------------------------------------------
# Painel do docente: alerta de desempenho baixo (acerto geral abaixo de PAINEL_DESEMPENHO_BAIXO
# com pelo menos PAINEL_MIN_RESPOSTAS respostas).
PAINEL_DESEMPENHO_BAIXO=0.5
PAINEL_MIN_RESPOSTAS=5
# Segurança (EAP 1.4.6). TIA_AUTH=desligada é o MODO DE DESENVOLVIMENTO (sem login, com aviso
# nas telas); nunca usar com dados reais. Padrão: ligada.
TIA_AUTH=ligada
AUTH_PROVEDOR=local
# Sessão: expira após 30 min sem uso e, de qualquer forma, 8 h após o login
AUTH_SESSAO_INATIVIDADE_MINUTOS=30
AUTH_SESSAO_MAXIMA_MINUTOS=480
# Cookie só por HTTPS; os navegadores aceitam em http://localhost
AUTH_COOKIE_SEGURO=1
AUTH_MAX_FALHAS_USUARIO=5
AUTH_MAX_FALHAS_IP=20
AUTH_JANELA_MINUTOS=15
AUTH_ATRASO_SEGUNDOS=1.0
# Política de senha (PROVISÓRIO): tamanho mínimo e bloqueio das mais comuns;
# AUTH_SENHAS_COMUNS_EXTRA = arquivo opcional com mais senhas proibidas, uma por linha
AUTH_SENHA_MINIMA=10
AUTH_SENHA_BLOQUEAR_COMUNS=1
AUTH_SENHAS_COMUNS_EXTRA=
# Retenção do IP das tentativas de login e dos pedidos sem login (dias, PROVISÓRIO)
AUTH_RETENCAO_IP_DIAS=30
# Limpeza automática pela API (minutos; 0 = só pelo comando python -m tia.seguranca.limpeza)
AUTH_LIMPEZA_MINUTOS=60
# Pedidos sem login: um registro de auditoria por origem e janela, os demais só contados
AUTH_ANONIMOS_JANELA_MINUTOS=10
AUTH_ANONIMOS_MAX_ORIGENS=50
# LGPD: prazos de retenção em dias (PROVISÓRIOS, a validar com o jurídico/DEP), aplicados por
# python -m tia.seguranca.retencao --aplicar (agendar no cron). A auditoria nunca é apagada:
# depois do prazo, só os códigos dela são anonimizados.
RETENCAO_RESPOSTAS_DIAS=365
RETENCAO_DIALOGO_DIAS=180
RETENCAO_FEEDBACK_TEXTO_DIAS=180
RETENCAO_AUDITORIA_DIAS=730
# Cópias do banco feitas antes de apagar dados (vazio = pasta "copias" ao lado do banco)
RETENCAO_COPIAS_DIAS=30
COPIAS_DIR=
# Ambiente: "producao" (padrão; a API não sobe com configuração insegura e /docs fica
# desligado) ou "desenvolvimento" (só na máquina de quem desenvolve)
TIA_AMBIENTE=producao
# Documentação interativa /docs e /openapi.json (padrão: 1 em desenvolvimento, 0 em produção)
# API_DOCS=0
# Implantação na VM (deploy/): backup (vazio = pasta "backup" ao lado do banco) e dias guardados,
# endereço local da API para o teste de fumaça e limite do R09 no resumo da medição
BACKUP_DIR=
BACKUP_DIAS=14
API_URL_LOCAL=http://127.0.0.1:8000
R09_LIMITE_SEGUNDOS=15
