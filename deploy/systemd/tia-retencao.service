# retenção LGPD em modo SIMULAÇÃO (só lista o que passou do prazo)
# Disparado por tia-retencao.timer (deploy/instalar.sh troca @TIA_RAIZ@ e @TIA_USUARIO@).
# Saída no journal: journalctl -u tia-retencao.service
[Unit]
Description=TIA - retenção LGPD em modo SIMULAÇÃO (só lista o que passou do prazo)
After=network.target

[Service]
Type=oneshot
User=@TIA_USUARIO@
Group=@TIA_USUARIO@
WorkingDirectory=@TIA_RAIZ@/atual
EnvironmentFile=@TIA_RAIZ@/config/.env
ExecStart=@TIA_RAIZ@/atual/venv/bin/python -m tia.seguranca.retencao --simular
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@TIA_RAIZ@/data
